{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Team",
  "type": "object",
  "description": "Team schema",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "description": {
      "type": "string",
      "description": "Team description"
    },
    "avatar_url": {
      "type": "string",
      "description": "Team avatar"
    },
    "header_url": {
      "type": "string",
      "description": "Team header/banner image"
    },
    "member_emails": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Emails of team members"
    },
    "member_profile_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Profile IDs of team members"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["name"],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.member_emails": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}

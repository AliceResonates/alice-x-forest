import { client } from './client';

// Lightweight wrapper to expose `base44.entities.<Entity>.filter/create` API
export const base44 = {
  entities: new Proxy({}, {
    get(_, entityName) {
      const name = String(entityName);
      return {
        async filter(query = {}, sort = null, limit = 100) {
          // Try to use client.db.list, otherwise fallback to empty
          try {
            const res = await client.db.list(name.toLowerCase(), { query, sort, limit });
            return Array.isArray(res) ? res : [];
          } catch (e) {
            return [];
          }
        },
        async create(doc) {
          try {
            return await client.db.create(name.toLowerCase(), doc);
          } catch (e) {
            // emulate created doc
            return { id: `doc_${Date.now()}`, ...doc };
          }
        },
        async get(id) {
          try {
            return await client.db.get(name.toLowerCase(), id);
          } catch (e) {
            return null;
          }
        }
      };
    }
  })
};

export default base44;

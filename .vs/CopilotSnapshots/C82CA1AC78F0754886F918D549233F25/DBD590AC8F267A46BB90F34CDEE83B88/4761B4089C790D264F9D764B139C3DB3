import React from 'react';
import AvatarDisplay from './shared/AvatarDisplay';
import { formatDistanceToNow } from 'date-fns';
import { de } from 'date-fns/locale';

export default function ChatRoomList({ rooms = [], user, onSelect = () => {} }) {
  if (!rooms || rooms.length === 0) {
    return (
      <div className="text-center py-12 text-muted-foreground text-sm">
        Keine Chats. Starte einen neuen!
      </div>
    );
  }

  return (
    <div className="space-y-1">
      {rooms.map(room => {
        const otherName = room.participant_names?.find((_, i) => room.participant_emails?.[i] !== user?.email)
          || room.participant_emails?.find(e => e !== user?.email)
          || room.name || 'Chat';

        return (
          <button
            key={room.id}
            onClick={() => onSelect(room)}
            className="w-full flex items-center gap-3 p-3 rounded-xl hover:bg-secondary/50 transition-colors text-left"
          >
            <AvatarDisplay name={otherName} size="md" />
            <div className="flex-1 min-w-0">
              <div className="flex items-center justify-between">
                <span className="text-sm font-medium truncate">{otherName}</span>
                {room.last_message_at && (
                  <span className="text-[10px] text-muted-foreground">
                    {formatDistanceToNow(new Date(room.last_message_at), { addSuffix: true, locale: de })}
                  </span>
                )}
              </div>
              {room.last_message && (
                <p className="text-xs text-muted-foreground truncate">{room.last_message}</p>
              )}
            </div>
          </button>
        );
      })}
    </div>
  );
}

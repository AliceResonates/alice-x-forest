import React from 'react';

export default function MoodBarometer({ text }) {
  // Very simple heuristic: count positive vs negative words
  const positive = ['good', 'great', 'happy', 'love', 'glad', 'awesome'];
  const negative = ['bad', 'sad', 'angry', 'upset', 'hate'];
  const t = (text || '').toLowerCase();
  let score = 0;
  positive.forEach(w => { if (t.includes(w)) score += 1; });
  negative.forEach(w => { if (t.includes(w)) score -= 1; });
  const pct = Math.min(100, Math.max(0, 50 + score * 10));

  return (
    <div className="w-full">
      <div className="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
        <div style={{ width: `${pct}%` }} className="h-2 bg-green-400" />
      </div>
    </div>
  );
}

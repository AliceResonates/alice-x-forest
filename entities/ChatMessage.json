{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "ChatMessage",
  "type": "object",
  "description": "Schema for a chat message",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Chat room ID"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "font_color": {
      "type": "string",
      "default": "#a8e6a3"
    }
  },
  "required": [
    "room_id",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}

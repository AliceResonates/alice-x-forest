{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "ChatRoom",
  "type": "object",
  "description": "Schema for a chat room",
  "properties": {
    "name": {
      "type": "string",
      "description": "Chat room name (for group chats)"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ],
      "default": "direct"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of participants"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "participant_emails"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.participant_emails": "{{user.email}}"
    },
    "update": {
      "data.participant_emails": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
